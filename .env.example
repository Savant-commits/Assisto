# Public client variable (exposed to browser): Supabase project URL. Required by Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public client variable (exposed to browser): Supabase anon/publishable key. Required by Supabase clients; access is controlled by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public client variable (exposed to browser): Site origin for confirmation emails. Optional locally (defaults to http://localhost:3000); set to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public client variable (exposed to browser): Optional map tile template. Defaults to OpenStreetMap tiles when unset.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Public client variable (exposed to browser): Optional map attribution markup. Defaults to OpenStreetMap attribution when unset.
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Server-only secret: Supabase service-role key. Required when server-side admin database operations run; bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Server-only secret: Resend API key. Required for outbound email sending; without it, Resend requests fail. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your-resend-api-key
# Server-only setting: Verified sender address for outbound email. Required by sendEmail(); missing value throws an explicit configuration error.
EMAIL_FROM=Assisto <no-reply@example.com>
# Server-only setting: Optional phone-verification gate. Defaults to false; set true to require phone verification.
REQUIRE_PHONE_VERIFICATION=false

# Next.js-managed variable read for development diagnostics. Next.js sets this automatically; do not configure it in .env files.
# NODE_ENV=<set automatically by Next.js>