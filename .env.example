# Public client variable: Supabase project URL; safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=
# Public client variable: Supabase anon key; protected by Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret: Supabase service-role key; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only secret: Resend API key; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Server-only setting: verified sender address used for outbound email.
EMAIL_FROM=
# Next.js-managed environment mode used to enable development diagnostics.
NODE_ENV=